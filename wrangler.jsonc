{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "candle-studio-pro",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "vars": {
    "INTEGRATION_ORIGIN": "https://candle-studio-pro.algonlinesrl.workers.dev",
    "META_GRAPH_VERSION": "v24.0"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "candle-studio-pro-db",
      "database_id": "652efd59-b1e8-4280-a9c8-91a0e284de68",
      "migrations_dir": "migrations"
    }
  ]
}
